exports[`ConfigSampler Component > Regression: Content Snapshots > matches snapshot for YAML content constants 2`] = `
"model:
  default: claude-sonnet-4-6
  triage: claude-haiku-4-5-20251001
  large_pr: claude-opus-4-8

review:
  ignore_globs:
    - "**/*.lock"
    - "**/*.min.js"
    - "vendor/**"
  severity_threshold: info
  tone: balanced
  language: en
  budget_cap_usd: 0.50

features:
  inline_comments: true
  cost_footer: true
  commands: true
  triage_pass: true

conventions_file: .github/conventions.md

authorization:
  allowed_users:
    - alice
    - bob"
`;

exports[`ConfigSampler Component > Regression: Content Snapshots > matches snapshot for YAML content constants 3`] = `
"review:
  scope_rules:
    # Skip generated files entirely
    - paths: ["**/generated/**", "**/*.gen.ts"]
      ignore: true

    # Detailed review for security-sensitive code
    - paths: ["src/auth/**", "src/crypto/**"]
      tone: detailed
      severity_threshold: info

    # Use Opus for infrastructure changes
    - paths: ["terraform/**", "k8s/**"]
      labels: ["infrastructure"]
      model: claude-opus-4-8

    # Concise reviews for documentation PRs
    - labels: ["docs"]
      tone: concise
      severity_threshold: major"
`;

