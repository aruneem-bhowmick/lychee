exports[`CommandsTable > Visual/Snapshot > matches the golden snapshot 1`] = `
<div>
  <section
    class="_section_947488"
    id="commands"
  >
    <div
      class="_container_947488"
    >
      <h2
        class="_heading_947488"
      >
        Interactive Commands
      </h2>
      <div
        class="_tableWrapper_947488"
      >
        <table
          class="_table_947488"
        >
          <thead>
            <tr>
              <th
                scope="col"
              >
                Comment
              </th>
              <th
                scope="col"
              >
                What it posts
              </th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>
                <code
                  class="_code_947488"
                >
                  @lychee peel
                </code>
              </td>
              <td>
                Full review: Nectar + The Peel + Pits (same as automatic review)
              </td>
            </tr>
            <tr>
              <td>
                <code
                  class="_code_947488"
                >
                  @lychee juice
                </code>
              </td>
              <td>
                Nectar section only — the short summary paragraph
              </td>
            </tr>
            <tr>
              <td>
                <code
                  class="_code_947488"
                >
                  @lychee pit
                </code>
              </td>
              <td>
                The single highest-severity finding only
              </td>
            </tr>
            <tr>
              <td>
                <code
                  class="_code_947488"
                >
                  @lychee ripe?
                </code>
              </td>
              <td>
                Ripeness verdict only — 🟢 Ripe, 🟡 Unripe, or 🔴 Sour
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <p
        class="_description_947488"
      >
        Commands respect all the same configuration as automatic reviews: 
        <code>
          severity_threshold
        </code>
        , 
        <code>
          tone
        </code>
        , 
        <code>
          scope_rules
        </code>
        , 
        <code>
          inline_comments
        </code>
        , and 
        <code>
          cost_footer
        </code>
         all apply. Access can be restricted to specific GitHub logins via 
        <code>
          authorization.allowed_users
        </code>
         in 
        <code>
          .lychee.yml
        </code>
        . Unknown commands receive a help message listing all four.
      </p>
      <p
        class="_snippetTitle_947488"
      >
        Enable commands by adding to .lychee.yml:
      </p>
      <div
        class="_codeBlockWrapper_947488"
      >
        <div
          data-filename=".lychee.yml"
          data-testid="mock-codeblock"
        >
          features:
  commands: true

authorization:
  allowed_users:   # leave empty to allow all users
    - alice
    - bob
        </div>
      </div>
      <a
        class="_cta_947488"
