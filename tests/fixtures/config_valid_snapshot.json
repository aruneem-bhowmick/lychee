{
  "app": null,
  "authorization": {
    "allowed_users": [
      "admin-user",
      "bot-user"
    ]
  },
  "conventions_file": "CONVENTIONS.md",
  "features": {
    "commands": true,
    "cost_footer": false,
    "inline_comments": true,
    "triage_pass": false
  },
  "model": {
    "default": "claude-opus-4-8",
    "large_pr": "claude-opus-4-8",
    "triage": "claude-sonnet-4-6"
  },
  "review": {
    "budget_cap_usd": null,
    "ignore_globs": [
      "*.lock",
      "dist/**"
    ],
    "language": "fr",
    "max_file_bytes": 51200,
    "max_files": 25,
    "scope_rules": [
      {
        "ignore": false,
        "labels": [],
        "model": "claude-opus-4-8",
        "paths": [
          "src/core/**"
        ],
        "severity_threshold": "critical",
        "tone": null
      },
      {
        "ignore": true,
        "labels": [
          "generated"
        ],
        "model": null,
        "paths": [],
        "severity_threshold": null,
        "tone": null
      }
    ],
    "severity_threshold": "major",
    "tone": "concise"
  }
}